rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function admin(){return signed() && exists(/databases/$(database)/documents/jusa_admins/$(request.auth.uid)) && get(/databases/$(database)/documents/jusa_admins/$(request.auth.uid)).data.enabled == true;}
  function active(){return signed() && get(/databases/$(database)/documents/jusa_users/$(request.auth.uid)).data.status == '승인 완료';}
  function question(id){return get(/databases/$(database)/documents/jusa_questions/$(id)).data;}
  function participant(id){return active() && (question(id).ownerId == request.auth.uid || question(id).mentorId == request.auth.uid);}
  function shared(id){let r = /databases/$(database)/documents/jusa_caseRequests/$(id + '_' + request.auth.uid); return active() && question(id).status == '완료' && exists(r) && get(r).data.mentorConsent == '승인' && get(r).data.menteeConsent == '승인' && get(r).data.requesterId == request.auth.uid;}
  function userShape(d){return d.keys().hasAll(['uid','name','dept','tags','experience','available','roles','status','avatar','tint','bg','accessory','createdAt']) && d.keys().hasOnly(['uid','name','dept','tags','experience','available','roles','status','avatar','tint','bg','accessory','createdAt']) && d.uid is string && d.name is string && d.name.size() >= 2 && d.name.size() <= 16 && d.dept is string && d.dept.size()>0 && d.dept.size()<=80 && d.tags is string && d.tags.size()<=500 && d.experience is string && d.experience.size()<=3000 && d.available is bool && d.roles is list && d.roles.size()>=1 && d.roles.size()<=2 && d.roles.hasOnly(['멘토','멘티']) && d.tint in ['#83ac74','#648ba8','#b78ba2','#caa766','#9582bb','#536c65','#d2a060','#dca9ae','#cf8050','#9983be','#cfb455'] && d.bg in ['#e8efdf','#e1eaf4','#f4e3ea','#faf0d6'] && d.accessory in ['none','glasses','blush','tie'];}
  function avatarAllowed(uid, avatar){let xp=getAfter(/databases/$(database)/documents/jusa_progress/$(uid)).data.xp;return avatar=='sprout' || (avatar=='cat' && xp>=100) || (avatar=='rabbit' && xp>=300) || (avatar=='fox' && xp>=600) || (avatar=='wizard' && xp>=1000) || (avatar=='crown' && xp>=1500);}
  match /jusa_admins/{uid}{allow get: if signed() && request.auth.uid==uid;allow list,write:if false;}
  match /jusa_nicknames/{nick}{allow get:if signed();allow list:if false;allow create:if signed() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid==request.auth.uid && getAfter(/databases/$(database)/documents/jusa_users/$(request.auth.uid)).data.name==nick;allow update:if false;allow delete:if signed() && resource.data.uid==request.auth.uid && getAfter(/databases/$(database)/documents/jusa_users/$(request.auth.uid)).data.name!=nick;}
  match /jusa_privateUsers/{uid}{allow read:if signed() && (request.auth.uid==uid || admin());allow create:if signed() && request.auth.uid==uid && request.resource.data.keys().hasOnly(['realName','email']) && request.resource.data.realName is string && request.resource.data.realName.size()>0 && request.resource.data.realName.size()<=30 && request.resource.data.email==request.auth.token.email;allow update,delete:if false;}
  match /jusa_users/{uid}{
   allow get:if signed() && (request.auth.uid==uid || active() || admin());allow list:if admin() || active();
   allow create:if signed() && request.auth.uid==uid && userShape(request.resource.data) && request.resource.data.uid==uid && request.resource.data.status=='승인 대기' && request.resource.data.avatar=='sprout' && request.resource.data.createdAt==request.time && getAfter(/databases/$(database)/documents/jusa_nicknames/$(request.resource.data.name)).data.uid==uid;
   allow update:if userShape(request.resource.data) && ((admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['승인 완료','반려','이용 정지','승인 대기']) || (active() && request.auth.uid==uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','dept','tags','experience','available','avatar','tint','bg','accessory']) && avatarAllowed(uid,request.resource.data.avatar) && getAfter(/databases/$(database)/documents/jusa_nicknames/$(request.resource.data.name)).data.uid==uid));allow delete:if false;
  }
  function publicQuestion(d){return d.keys().hasAll(['ownerId','author','dept','title','category','tags','status','mentorId','mentor','applicantCount','createdAt']) && d.keys().hasOnly(['ownerId','author','dept','title','category','tags','status','mentorId','mentor','applicantCount','createdAt','completedAt','rating']) && d.title is string && d.title.size()>0 && d.title.size()<=100 && d.category in ['예산·회계','계약·지출','인사·복무','사업·기획','민원·복지'] && d.tags is list && d.tags.size()<=15 && d.applicantCount is int && d.applicantCount>=0;}
  match /jusa_questions/{id}{
   allow read:if active() || admin();
   allow create:if active() && get(/databases/$(database)/documents/jusa_users/$(request.auth.uid)).data.roles.hasAny(['멘티']) && publicQuestion(request.resource.data) && request.resource.data.ownerId==request.auth.uid && request.resource.data.author==get(/databases/$(database)/documents/jusa_users/$(request.auth.uid)).data.name && request.resource.data.dept==get(/databases/$(database)/documents/jusa_users/$(request.auth.uid)).data.dept && request.resource.data.status=='모집 중' && request.resource.data.mentorId=='' && request.resource.data.mentor=='' && request.resource.data.applicantCount==0 && request.resource.data.createdAt==request.time && !request.resource.data.keys().hasAny(['completedAt','rating']);
   allow update:if active() && publicQuestion(request.resource.data) && (
    (resource.data.status=='모집 중' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantCount']) && request.resource.data.applicantCount==resource.data.applicantCount+1 && !exists(/databases/$(database)/documents/jusa_questions/$(id)/applications/$(request.auth.uid)) && existsAfter(/databases/$(database)/documents/jusa_questions/$(id)/applications/$(request.auth.uid))) ||
    (resource.data.ownerId==request.auth.uid && resource.data.status=='모집 중' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','mentorId','mentor']) && request.resource.data.status=='진행 중' && request.resource.data.mentorId!=request.auth.uid && exists(/databases/$(database)/documents/jusa_questions/$(id)/applications/$(request.resource.data.mentorId)) && get(/databases/$(database)/documents/jusa_users/$(request.resource.data.mentorId)).data.status=='승인 완료' && request.resource.data.mentor==get(/databases/$(database)/documents/jusa_users/$(request.resource.data.mentorId)).data.name) ||
    (resource.data.ownerId==request.auth.uid && resource.data.status=='진행 중' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completedAt','rating']) && request.resource.data.status=='완료' && request.resource.data.completedAt==request.time && request.resource.data.rating is int && request.resource.data.rating>=1 && request.resource.data.rating<=5 && existsAfter(/databases/$(database)/documents/jusa_rewards/$(id)))
   );allow delete:if false;
   match /applications/{uid}{allow read:if active();allow create:if active() && uid==request.auth.uid && question(id).ownerId!=request.auth.uid && question(id).status=='모집 중' && get(/databases/$(database)/documents/jusa_users/$(uid)).data.roles.hasAny(['멘토']) && get(/databases/$(database)/documents/jusa_users/$(uid)).data.available==true && request.resource.data.keys().hasOnly(['uid','name','createdAt']) && request.resource.data.uid==uid && request.resource.data.name==get(/databases/$(database)/documents/jusa_users/$(uid)).data.name && request.resource.data.createdAt==request.time && getAfter(/databases/$(database)/documents/jusa_questions/$(id)).data.applicantCount==question(id).applicantCount+1;allow update,delete:if false;}
   match /messages/{messageId}{allow read:if participant(id) || shared(id);allow create:if participant(id) && question(id).status=='진행 중' && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt']) && request.resource.data.senderId==request.auth.uid && request.resource.data.senderName==get(/databases/$(database)/documents/jusa_users/$(request.auth.uid)).data.name && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=3000 && request.resource.data.createdAt==request.time;allow update,delete:if false;}
  }
  match /jusa_questionDetails/{id}{allow get:if participant(id) || shared(id);allow list:if false;allow create:if active() && getAfter(/databases/$(database)/documents/jusa_questions/$(id)).data.ownerId==request.auth.uid && request.resource.data.keys().hasOnly(['body']) && request.resource.data.body is string && request.resource.data.body.size()>0 && request.resource.data.body.size()<=3000;allow update,delete:if false;}
  match /jusa_caseRequests/{id}{
   allow read:if active() && (resource.data.requesterId==request.auth.uid || resource.data.ownerId==request.auth.uid || resource.data.mentorId==request.auth.uid);
   allow create:if active() && request.resource.data.keys().hasOnly(['questionId','title','ownerId','mentorId','requesterId','requesterName','reason','mentorConsent','menteeConsent','createdAt','updatedAt']) && request.resource.data.questionId is string && id==request.resource.data.questionId+'_'+request.auth.uid && question(request.resource.data.questionId).status=='완료' && request.resource.data.ownerId==question(request.resource.data.questionId).ownerId && request.resource.data.mentorId==question(request.resource.data.questionId).mentorId && request.resource.data.title==question(request.resource.data.questionId).title && !(request.auth.uid in [request.resource.data.ownerId,request.resource.data.mentorId]) && request.resource.data.requesterId==request.auth.uid && request.resource.data.requesterName==get(/databases/$(database)/documents/jusa_users/$(request.auth.uid)).data.name && request.resource.data.reason is string && request.resource.data.reason.size()>0 && request.resource.data.reason.size()<=500 && request.resource.data.mentorConsent=='대기' && request.resource.data.menteeConsent=='대기' && request.resource.data.createdAt==request.time && request.resource.data.updatedAt==request.time;
   allow update:if active() && request.resource.data.updatedAt==request.time && ((resource.data.mentorId==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mentorConsent','updatedAt']) && request.resource.data.mentorConsent in ['승인','반려','대기']) || (resource.data.ownerId==request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['menteeConsent','updatedAt']) && request.resource.data.menteeConsent in ['승인','반려','대기']));allow delete:if false;
  }
  match /jusa_rewards/{id}{allow read:if active() && (resource.data.mentorId==request.auth.uid || admin());allow create:if active() && request.auth.uid==question(id).ownerId && question(id).status=='진행 중' && getAfter(/databases/$(database)/documents/jusa_questions/$(id)).data.status=='완료' && request.resource.data.keys().hasOnly(['mentorId','amount','createdAt']) && request.resource.data.mentorId==question(id).mentorId && request.resource.data.amount==20 && request.resource.data.createdAt==request.time && getAfter(/databases/$(database)/documents/jusa_progress/$(request.resource.data.mentorId)).data.lastRewardId==id;allow update,delete:if false;}
  match /jusa_progress/{uid}{allow get:if signed() && (request.auth.uid==uid || active() || admin());allow list:if false;allow create:if signed() && uid==request.auth.uid && request.resource.data.keys().hasOnly(['xp','lastRewardId']) && request.resource.data.xp==0 && request.resource.data.lastRewardId=='';allow update:if active() && request.resource.data.keys().hasOnly(['xp','lastRewardId']) && request.resource.data.xp==resource.data.xp+20 && request.resource.data.lastRewardId is string && !exists(/databases/$(database)/documents/jusa_rewards/$(request.resource.data.lastRewardId)) && getAfter(/databases/$(database)/documents/jusa_rewards/$(request.resource.data.lastRewardId)).data.mentorId==uid && getAfter(/databases/$(database)/documents/jusa_rewards/$(request.resource.data.lastRewardId)).data.amount==20 && question(request.resource.data.lastRewardId).ownerId==request.auth.uid;allow delete:if false;}
 }
}
